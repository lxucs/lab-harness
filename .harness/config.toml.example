# Example harness configuration.
#
# Copy to .harness/config.toml (committed, non-sensitive) or
# .harness/config.local.toml (gitignored, for machine-specific values).
#
# NEVER put API keys, absolute paths, or private endpoints in config.toml.
# Keys belong in environment variables, or in config.local.toml. See
# docs/configuration.md.
#
# Every value shown is the current default, so a key you do not set behaves
# exactly as written here. Unknown keys are an error rather than being ignored:
# a typo that silently left the default in place would be found days later.

[agent]
# Ceiling on provider requests in one run. Guards against a model that calls
# tools forever.
max_turns = 50
# Run independent tool calls from one assistant message concurrently.
parallel_tools = true
# Model used when neither --model nor $HARNESS_MODEL names one. An id missing
# from the catalog still works; it is assumed current and given conservative
# limits.
model = "claude-sonnet-5"
# Name of the environment variable that overrides `model`. The name is a
# config key so a deployment using a different one changes config, not code.
model_env = "HARNESS_MODEL"
# Provider for a model id nothing else routes -- not listed in any
# providers.openai profile and not in the catalog. --provider overrides it.
provider = "anthropic"

[project]
# Files read from the working directory for this project's own instructions,
# which are appended to the system prompt. The first that exists wins -- an
# empty file therefore means "no instructions", not "try the next one".
context_files = ["HARNESS.md", "AGENTS.md"]
# A longer file is truncated. These instructions ride along on every request,
# so an unbounded file is an unbounded bill.
max_bytes = 32000

[tools.read]
# Lines returned when the model requests no explicit limit.
default_limit = 2000
# Longer lines are clipped, so one minified file cannot flood the context.
max_line_length = 2000
# Files above this are refused rather than read.
max_bytes = 256000

[tools.list]
# Entries returned per `ls`.
max_entries = 1000

[tools.bash]
# Default wall-clock ceiling for one command, in seconds.
timeout_seconds = 120
# Highest timeout a single call may request. A model asking for an hour is a bug.
max_timeout_seconds = 600
# Combined stdout+stderr kept. Head and tail are preserved, middle elided.
max_output_bytes = 30000
# How often streaming output is forwarded, in seconds.
update_interval_seconds = 0.5

[tools.search]
# Matches returned by one grep.
max_results = 200
# Paths returned by one glob.
max_files = 500
# Longer matching lines are clipped in grep output.
max_line_length = 400
# Directory names never descended into.
ignored_directories = [
    ".git", ".venv", "venv", "node_modules", "__pycache__",
    ".mypy_cache", ".pytest_cache", ".ruff_cache", "dist", "build", ".tox",
]

[tools.web]
# Which backend web_search uses: "tavily" (needs a key) or "ddgs" (keyless,
# scrapes, so rate-limited and occasionally brittle).
backend = "tavily"
# Results requested per search.
max_results = 5
# Wall-clock limit for one search or one fetch, in seconds.
timeout_seconds = 30.0
# Largest response web_fetch will download, before text extraction.
max_bytes = 2000000
# Characters of extracted text handed to the model.
max_content_chars = 50000
# Sent on every outbound request. Some sites refuse an unidentified client.
user_agent = "harness/0.1 (+https://github.com/lxucs/harness)"

[tools.web.tavily]
# Name of the environment variable the key is read from. The key itself goes
# in the environment or in config.local.toml -- NEVER in this file.
api_key_env = "TAVILY_API_KEY"
# "basic" spends one API credit per search, "advanced" two for better
# extraction. Basic by default so a free tier lasts.
search_depth = "basic"
# Request full page text beside each snippet. Off by default: raw content for
# five results is usually far more than the answer needs, and web_fetch can
# get it for the one result that matters.
include_raw_content = false

[tools.web.ddgs]
# Upstream engine to query. "auto" lets ddgs choose and rotate.
engine = "auto"
# Result region, e.g. "us-en", "uk-en", "ru-ru".
region = "us-en"

[tools.approval]
# Tools that prompt before executing in interactive mode. One-shot (-p) runs
# have no gate at all -- there is nobody at the keyboard to answer.
required = ["bash", "write", "edit"]
# Whether answering "always" is remembered. Session-only, never persisted.
allow_remember = true

[terminal]
# Tools the interactive terminal enables.
enabled_tools = [
    "read", "write", "edit", "ls", "bash", "grep", "glob",
    "web_search", "web_fetch",
]
# Lines of tool output shown before collapsing to a summary.
max_result_lines = 12
# Render assistant text as markdown.
markdown = true

[session]
# Root for all harness state. Overridden by $HARNESS_HOME.
home = "~/.harness"
home_env = "HARNESS_HOME"
# Subdirectory of home holding per-project session directories.
directory_name = "sessions"
# Write transcripts to disk at all.
enabled = true
# Schema version written into each file header. A protocol constant, not a knob.
version = 1

[providers.anthropic]
# Names of the environment variables credentials are read from. The values
# themselves are never written here.
auth_token_env = "ANTHROPIC_AUTH_TOKEN"
api_key_env = "ANTHROPIC_API_KEY"
base_url_env = "ANTHROPIC_BASE_URL"
# Sampling ceiling when the model declares none.
default_max_tokens = 8192
# Thinking budget when reasoning is requested, in tokens.
thinking_budget_tokens = 4096

# Endpoints in the OpenAI family, keyed by profile name. Unlike every other
# section, NEW KEYS HERE ARE ALLOWED: adding [providers.openai.<name>] creates
# a profile, which is how a vendor is supported without touching code. Keys
# *inside* a profile are still checked.
#
# `api` picks the protocol:
#   "responses"         OpenAI's current API. Carries a reasoning model's
#                       chain of thought across a tool call (encrypted).
#   "chat_completions"  What everyone else speaks -- DeepSeek, GLM, Groq,
#                       OpenRouter, vLLM, Ollama.
#
# A model id listed in a profile's `models` routes to it, so
# `harness --model deepseek-chat` needs no --provider flag.
#
# Keys are never written here. Set the environment variable named by
# api_key_env, or put api_key in gitignored config.local.toml.

[providers.openai.openai]
api = "responses"
base_url = "https://api.openai.com/v1"
api_key_env = "OPENAI_API_KEY"
base_url_env = "OPENAI_BASE_URL"
# Model ids this profile serves. Empty here: OpenAI ids change often enough
# that routing by --provider or agent.provider is the honest default.
models = []
# Sampling ceiling when the model declares none.
default_max_tokens = 8192
# Wall-clock limit for one streamed request.
timeout_seconds = 120.0
# chat_completions only: ask for token counts in the stream. Turn off for a
# server that rejects stream_options -- some implementations do.
include_usage = true
# responses only: detail of the reasoning summary ("auto", "concise",
# "detailed"). Empty asks for none, which makes thinking invisible -- the raw
# chain is never returned, so the summary is the only readable form.
reasoning_summary = "auto"
# responses only: let the server keep the conversation and refer to it by id.
# Off, because this harness owns its transcript. Turning it on disables
# encrypted-reasoning replay.
store = false

[providers.openai.deepseek]
api = "chat_completions"
base_url = "https://api.deepseek.com/v1"
api_key_env = "DEEPSEEK_API_KEY"
base_url_env = "DEEPSEEK_BASE_URL"
models = ["deepseek-chat", "deepseek-reasoner"]
default_max_tokens = 8192
timeout_seconds = 120.0
include_usage = true
reasoning_summary = "auto"
store = false

[providers.openai.glm]
api = "chat_completions"
# The mainland endpoint. International is https://api.z.ai/api/paas/v4
base_url = "https://open.bigmodel.cn/api/paas/v4"
api_key_env = "ZHIPUAI_API_KEY"
base_url_env = "ZHIPUAI_BASE_URL"
models = ["glm-4.6", "glm-4.5", "glm-4.5-air"]
default_max_tokens = 8192
timeout_seconds = 120.0
include_usage = true
reasoning_summary = "auto"
store = false

# Any other endpoint is one more section. For example:
#
# [providers.openai.groq]
# base_url = "https://api.groq.com/openai/v1"
# api_key_env = "GROQ_API_KEY"
# models = ["llama-3.3-70b-versatile"]
#
# [providers.openai.local]
# base_url = "http://localhost:11434/v1"   # Ollama
# api_key_env = "OLLAMA_API_KEY"
# models = ["qwen3:8b"]

[logging]
# Diagnostics about the harness itself, written to stderr. One of:
# debug, info, warning, error. A level set here cannot report the loading of
# this file — use $HARNESS_LOG_LEVEL or --log-level to debug config itself.
level = "warning"
level_env = "HARNESS_LOG_LEVEL"
# Format for one record.
format = "%(levelname)s %(name)s: %(message)s"
