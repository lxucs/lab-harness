# Example lab-harness configuration.
#
# Copy to .lab-harness/config.toml (committed, non-sensitive) or
# .lab-harness/config.local.toml (gitignored, for machine-specific values).
#
# NEVER put API keys, absolute paths, or private endpoints in config.toml.
# Keys belong in environment variables, or in config.local.toml. See
# docs/configuration.md.
#
# Every value shown is the current default, so a key you do not set behaves
# exactly as written here. Unknown keys are an error rather than being ignored:
# a typo that silently left the default in place would be found days later.

[agent]
# Ceiling on provider requests in one run. Guards against a model that calls
# tools forever.
max_turns = 50
# Run independent tool calls from one assistant message concurrently.
parallel_tools = true
# Model used when neither --model nor $LAB_HARNESS_MODEL names one. An id missing
# from the catalog still works; it is assumed current and given conservative
# limits.
model = "claude-sonnet-5"
# Name of the environment variable that overrides `model`. The name is a
# config key so a deployment using a different one changes config, not code.
model_env = "LAB_HARNESS_MODEL"
# Provider for a model id nothing else routes -- not listed in any
# providers.openai profile and not in the catalog. --provider overrides it.
provider = "anthropic"

[project]
# Files read from the working directory for this project's own instructions,
# which are appended to the system prompt. The first that exists wins -- an
# empty file therefore means "no instructions", not "try the next one".
context_files = ["HARNESS.md", "AGENTS.md"]
# A longer file is truncated. These instructions ride along on every request,
# so an unbounded file is an unbounded bill.
max_bytes = 32000

[tools.read]
# Lines returned when the model requests no explicit limit.
default_limit = 2000
# Longer lines are clipped, so one minified file cannot flood the context.
max_line_length = 2000
# Files above this are refused rather than read.
max_bytes = 256000

[tools.list]
# Entries returned per `ls`.
max_entries = 1000

[tools.diff]
# The diff edit and write report beside their result, for the terminal to
# show. Never sent to the model. Unchanged lines around each change:
context_lines = 3

[tools.bash]
# Default wall-clock ceiling for one command, in seconds.
timeout_seconds = 120
# Highest timeout a single call may request. A model asking for an hour is a bug.
max_timeout_seconds = 600
# Combined stdout+stderr kept. Head and tail are preserved, middle elided.
max_output_bytes = 30000
# How often streaming output is forwarded, in seconds.
update_interval_seconds = 0.5

[tools.search]
# Matches returned by one grep.
max_results = 200
# Paths returned by one glob.
max_files = 500
# Longer matching lines are clipped in grep output.
max_line_length = 400
# Directory names never descended into.
ignored_directories = [
    ".git", ".venv", "venv", "node_modules", "__pycache__",
    ".mypy_cache", ".pytest_cache", ".ruff_cache", "dist", "build", ".tox",
]

[tools.web]
# Which backend web_search uses: "tavily" (needs a key) or "ddgs" (keyless,
# scrapes, so rate-limited and occasionally brittle).
backend = "tavily"
# Results requested per search.
max_results = 5
# Wall-clock limit for one search or one fetch, in seconds.
timeout_seconds = 30.0
# Largest response web_fetch will download, before text extraction.
max_bytes = 2000000
# Characters of extracted text handed to the model.
max_content_chars = 50000
# Sent on every outbound request. Some sites refuse an unidentified client.
user_agent = "lab-harness/0.1 (+https://github.com/lxucs/lab-harness)"

[tools.web.tavily]
# Name of the environment variable the key is read from. The key itself goes
# in the environment or in config.local.toml -- NEVER in this file.
api_key_env = "TAVILY_API_KEY"
# "basic" spends one API credit per search, "advanced" two for better
# extraction. Basic by default so a free tier lasts.
search_depth = "basic"
# Request full page text beside each snippet. Off by default: raw content for
# five results is usually far more than the answer needs, and web_fetch can
# get it for the one result that matters.
include_raw_content = false

[tools.web.ddgs]
# Upstream engine to query. "auto" lets ddgs choose and rotate.
engine = "auto"
# Result region, e.g. "us-en", "uk-en", "ru-ru".
region = "us-en"

[tools.approval]
# Tools that prompt before executing in interactive mode. One-shot (-p) runs
# have no gate at all -- there is nobody at the keyboard to answer.
required = ["bash", "write", "edit"]
# Whether answering "always" is remembered. Session-only, never persisted.
allow_remember = true

[terminal]
# Tools the interactive terminal enables.
enabled_tools = [
    "read", "write", "edit", "ls", "bash", "grep", "glob",
    "web_search", "web_fetch",
]
# Lines of tool output shown before collapsing to a summary.
max_result_lines = 12
# Lines of an edit's diff shown before collapsing -- more than plain output
# gets, since the diff is the part of an edit worth reading.
max_diff_lines = 40
# Render assistant text as markdown.
markdown = true
# What a model's reasoning leaves in scrollback once its message ends: "full",
# "collapse" to one line, or "hidden". The first two also show it as it
# streams. Ctrl-O switches between full and this for the rest of the session.
thinking = "collapse"
# Lines of reasoning shown while it streams, when it is going to collapse.
thinking_preview_lines = 4
# Print one line of token, cache and cost figures after each run. Type :status
# for the session's totals either way.
show_usage = true
# Label for amounts computed from model prices. Only a label -- nothing is
# converted, so it must match the currency the rates are quoted in.
currency_symbol = "$"

[terminal.theme]
# Styles by role, as rich style strings: a color name or hex, plus any of bold,
# dim, italic, underline. Checked at startup. The defaults follow Claude Code.
accent = "#d77757"        # the spinner
# The input prompt's glyph. Parsed by prompt_toolkit, not rich: hex colors and
# bold/italic/underline work in both, rich's rgb(...) form does not.
prompt = "bold #d77757"
muted = "dim"             # tool arguments and output, notices, the usage line
thinking = "italic dim"   # reasoning, streamed or expanded
tool = "bold"             # the tool's name in a call line
success = "green"         # the bullet of a call that finished cleanly
error = "red"             # failed calls and errors
warning = "yellow"        # cancellations, warnings, calls awaiting approval
# Whole lines of a diff. A foreground as well as the background, so they read
# the same on a light terminal as a dark one.
diff_added = "#ffffff on #225c2b"
diff_removed = "#ffffff on #7a2936"

[session]
# Root for all harness state. Overridden by $LAB_HARNESS_HOME.
home = "~/.lab-harness"
home_env = "LAB_HARNESS_HOME"
# Subdirectory of home holding per-project session directories.
directory_name = "sessions"
# Write transcripts to disk at all.
enabled = true
# Schema version written into each file header. A protocol constant, not a knob.
# Version 2 added the per-invocation `context` entry; version 1 files still read.
version = 2

[providers.anthropic]
# Names of the environment variables credentials are read from. The values
# themselves are never written here.
auth_token_env = "ANTHROPIC_AUTH_TOKEN"
api_key_env = "ANTHROPIC_API_KEY"
base_url_env = "ANTHROPIC_BASE_URL"
# Sampling ceiling when the model declares none.
default_max_tokens = 8192
# What comes back in a thinking block: "summarized" or "omitted". The 5-series
# models think whether asked or not, but default to omitted -- empty blocks, so
# nothing to show. Billing is the same either way. "" sends no preference.
thinking_display = "summarized"
# Models that take the older thinking request, a token budget, by id prefix:
# everything before 4.6. Every other reasoning model gets adaptive thinking,
# which the 5-series requires -- it rejects a budget with a 400.
budget_thinking_models = [
    "claude-haiku-4-5", "claude-sonnet-4-5", "claude-opus-4-5", "claude-opus-4-1",
    "claude-opus-4-0", "claude-opus-4-2025", "claude-sonnet-4-0",
    "claude-sonnet-4-2025", "claude-3",
]
# Budget for those models, in tokens, when reasoning is requested. They do not
# think otherwise.
thinking_budget_tokens = 4096

# The LLMs that ship -- the openai, deepseek and glm endpoints, and every model
# below -- are listed in lab_harness/llm/catalog.toml, in exactly this format.
# The two sections that follow show one entry each; a table here with a name
# the catalog uses overrides only the keys it gives, and a new name adds one.

# Endpoints in the OpenAI family, keyed by profile name. Like [models], and
# unlike every other section, NEW KEYS HERE ARE ALLOWED: adding
# [providers.openai.<name>] creates a profile, which is how a vendor is
# supported without touching code. Keys *inside* a profile are still checked.
#
# Keys are never written here. Set the environment variable named by
# api_key_env, or put api_key in gitignored config.local.toml.

[providers.openai.deepseek]
# The protocol:
#   "responses"         OpenAI's current API. Carries a reasoning model's
#                       chain of thought across a tool call (encrypted).
#   "chat_completions"  What everyone else speaks -- DeepSeek, GLM, Groq,
#                       OpenRouter, vLLM, Ollama.
api = "chat_completions"
base_url = "https://api.deepseek.com/v1"
api_key_env = "DEEPSEEK_API_KEY"
# Overrides base_url when set.
base_url_env = "DEEPSEEK_BASE_URL"
# Sampling ceiling when the model declares none.
default_max_tokens = 8192
# Wall-clock limit for one streamed request.
timeout_seconds = 120.0
# chat_completions only: ask for token counts in the stream. Turn off for a
# server that rejects stream_options -- some implementations do.
include_usage = true
# chat_completions only: field each earlier turn's reasoning is sent back in;
# empty sends none. DeepSeek returns a 400 for a tool loop without it, GLM asks
# for it unmodified, and a server that never asked for it may reject it -- so
# off by default, unless the vendor documents it.
replay_reasoning_field = "reasoning_content"
# chat_completions only: ask the server to keep earlier reasoning in context.
# GLM's Preserved Thinking -- sends GLM's own request shape, so leave it off
# for any other vendor. Also switches thinking on for GLM-4.6, which is hybrid.
preserve_thinking = false
# responses only: detail of the reasoning summary ("auto", "concise",
# "detailed"). Empty asks for none, which makes thinking invisible -- the raw
# chain is never returned, so the summary is the only readable form.
reasoning_summary = "auto"
# responses only: let the server keep the conversation and refer to it by id.
# Off, because this harness owns its transcript. Turning it on disables
# encrypted-reasoning replay.
store = false

# Any other endpoint is one more section, plus a [models] entry per model it
# serves. For example:
#
# [providers.openai.groq]
# base_url = "https://api.groq.com/openai/v1"
# api_key_env = "GROQ_API_KEY"
#
# [models."llama-3.3-70b-versatile"]   # quoted: a bare key cannot hold a dot
# provider = "groq"

# Every model the harness knows, keyed by model id. NEW KEYS ARE ALLOWED, as in
# [providers.openai]: each one adds a model. An id listed nowhere still works,
# with the conservative defaults of every key left out below.

[models.claude-sonnet-5]
# Display name. Empty shows the id.
name = "Claude Sonnet 5"
# "anthropic", or a [providers.openai] profile. Routes `--model <id>` with no
# --provider flag; empty leaves it to agent.provider. Pointing a catalogued
# model at a gateway or a local server is just this line.
provider = "anthropic"
# The vendor's documented limits. Defaults: 200000 and 8192.
context_window = 1000000
max_tokens = 64000
# Gates the thinking request an adapter sends. Default true: an unlisted id is
# assumed current.
supports_reasoning = true
# Recorded, not acted on. Default false.
supports_images = true
supports_server_tools = true

[models.claude-sonnet-5.price]
# USD per million tokens, used only to show a cost; nothing is enforced. The
# four rates mirror the four Usage counts, and one left out is zero. An all-zero
# price -- the default -- shows no cost, which is how to switch off a shipped
# one. Prices change: override any of them.
input = 2.0
output = 10.0
# Prompt tokens served from the cache.
cache_read = 0.2
# Prompt tokens written to the cache. Providers that cache implicitly (OpenAI,
# DeepSeek, GLM) report no writes, so this rate never applies to them.
cache_write = 2.5

[logging]
# Diagnostics about the harness itself, written to stderr. One of:
# debug, info, warning, error. "info" adds the decisions -- model, provider,
# transcript -- and a line per run; "debug" traces every request, response and
# tool call, by shape and id, never by content. A level set here cannot report
# the loading of this file — use $LAB_HARNESS_LOG_LEVEL or --log-level to debug
# config itself.
level = "warning"
level_env = "LAB_HARNESS_LOG_LEVEL"
# Format for one record.
format = "%(levelname)s %(name)s: %(message)s"
